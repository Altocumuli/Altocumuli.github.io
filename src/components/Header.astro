---
import { siteConfig } from '../data/site';

const currentPath = Astro.url.pathname;
const navItems = [
  { label: 'Research', href: '/#research' },
  { label: 'Work', href: '/#work' },
  { label: 'Experience', href: '/#experience' },
  { label: 'About', href: '/#about' },
];
---

<header class="site-header">
  <div class="container header-inner">
    <a class="brand" href="/" aria-label={`${siteConfig.initials} — ${siteConfig.name}, ${siteConfig.englishName}, home`}>
      <span class="brand-mark" aria-hidden="true">{siteConfig.initials}</span>
      <span class="brand-name">
        {siteConfig.name}
        <small>{siteConfig.englishName}</small>
      </span>
    </a>

    <nav aria-label="Primary navigation">
      <ul>
        {
          navItems.map((item) => (
            <li>
              <a
                href={item.href}
                aria-current={currentPath === item.href ? 'page' : undefined}
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <a class="header-contact" href={`mailto:${siteConfig.email}`}>Let's talk</a>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    z-index: 30;
    top: 0;
    border-bottom: 1px solid color-mix(in srgb, var(--line) 76%, transparent);
    background: color-mix(in srgb, var(--paper) 84%, transparent);
    backdrop-filter: blur(18px);
  }

  .header-inner {
    min-height: 74px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.72rem;
    color: var(--ink);
    font-weight: 720;
    letter-spacing: -0.02em;
  }

  .brand-mark {
    width: 2.2rem;
    height: 2.2rem;
    display: grid;
    place-items: center;
    border: 1px solid var(--ink);
    border-radius: 50%;
    font-family: var(--font-display);
    font-size: 0.72rem;
    font-style: italic;
  }

  .brand-name {
    display: inline-flex;
    align-items: baseline;
    gap: 0.5rem;
  }

  .brand-name small {
    color: var(--muted);
    font-size: 0.62rem;
    font-weight: 650;
    letter-spacing: 0.04em;
  }

  nav ul {
    display: flex;
    align-items: center;
    gap: clamp(1rem, 2.5vw, 2rem);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  nav a {
    color: var(--muted);
    font-size: 0.82rem;
    font-weight: 650;
    letter-spacing: 0.02em;
    transition: color 160ms ease;
  }

  nav a:hover,
  nav a:focus-visible {
    color: var(--ink);
  }

  .header-contact {
    padding: 0.7rem 1rem;
    border: 1px solid var(--ink);
    border-radius: 999px;
    color: var(--ink);
    font-size: 0.8rem;
    font-weight: 700;
    transition:
      color 160ms ease,
      background 160ms ease;
  }

  .header-contact:hover {
    color: var(--paper);
    background: var(--ink);
  }

  @media (max-width: 760px) {
    .header-inner {
      min-height: 64px;
    }

    .brand-name,
    .header-contact {
      display: none;
    }

    nav {
      max-width: calc(100vw - 6rem);
      overflow-x: auto;
      scrollbar-width: none;
    }

    nav::-webkit-scrollbar {
      display: none;
    }

    nav ul {
      gap: 1.2rem;
    }
  }
</style>
