---
import type { WorkEntry } from '../lib/work';
import { formatWorkDate, workHref } from '../lib/work';
import Icon from './Icon.astro';

interface Props {
  work: WorkEntry;
  large?: boolean;
}

const { work, large = false } = Astro.props;
const { data } = work;
---

<article class:list={['work-card', { large }, `accent-${data.accent}`]}>
  <a class="art" href={workHref(work)} tabindex="-1" aria-hidden="true">
    {
      data.cover ? (
        <img src={data.cover} alt="" loading="lazy" />
      ) : (
        <div class="generated-art">
          <span class="art-orbit one" />
          <span class="art-orbit two" />
          <span class="art-grid" />
          <span class="art-type">{data.type}</span>
          <span class="art-index">{String(data.date.getUTCFullYear()).slice(-2)}</span>
        </div>
      )
    }
  </a>

  <div class="card-body">
    <div class="meta-row">
      <span>{data.type}</span>
      <span class="separator" aria-hidden="true">·</span>
      <span>{formatWorkDate(data.date)}</span>
      {data.sample && <span class="sample-badge">Sample</span>}
    </div>

    <h3><a href={workHref(work)}>{data.title}</a></h3>
    <p class="summary">{data.summary}</p>

    <div class="card-footer">
      <ul class="tags" aria-label="Topics">
        {data.tags.slice(0, 3).map((tag) => <li>{tag}</li>)}
      </ul>
      <a class="read-link" href={workHref(work)} aria-label={`Explore ${data.title}`}>
        Explore <Icon name="arrow" size={17} />
      </a>
    </div>
  </div>
</article>

<style>
  .work-card {
    min-width: 0;
  }

  .art {
    position: relative;
    aspect-ratio: 16 / 10;
    display: block;
    overflow: hidden;
    border-radius: var(--radius-lg);
    background: var(--accent-soft);
  }

  .art::after {
    position: absolute;
    inset: 0;
    border: 1px solid color-mix(in srgb, var(--accent) 15%, var(--line));
    border-radius: inherit;
    content: '';
    pointer-events: none;
  }

  .art img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 500ms var(--ease-out);
  }

  .work-card:hover .art img {
    transform: scale(1.025);
  }

  .generated-art {
    position: absolute;
    inset: 0;
    overflow: hidden;
    background:
      radial-gradient(circle at 17% 8%, color-mix(in srgb, white 65%, transparent), transparent 30%),
      linear-gradient(145deg, var(--accent-soft), color-mix(in srgb, var(--accent) 13%, white));
  }

  .art-grid {
    position: absolute;
    inset: 0;
    opacity: 0.25;
    background-image:
      linear-gradient(color-mix(in srgb, var(--accent) 30%, transparent) 1px, transparent 1px),
      linear-gradient(90deg, color-mix(in srgb, var(--accent) 30%, transparent) 1px, transparent 1px);
    background-size: 42px 42px;
    mask-image: linear-gradient(to bottom right, black, transparent 70%);
  }

  .art-orbit {
    position: absolute;
    border: 1px solid color-mix(in srgb, var(--accent) 58%, transparent);
    border-radius: 50%;
    transition: transform 600ms var(--ease-out);
  }

  .art-orbit.one {
    width: 68%;
    aspect-ratio: 1;
    right: -13%;
    bottom: -42%;
    box-shadow:
      0 0 0 24px color-mix(in srgb, var(--accent) 5%, transparent),
      0 0 0 58px color-mix(in srgb, var(--accent) 4%, transparent);
  }

  .art-orbit.two {
    width: 23%;
    aspect-ratio: 1;
    top: 16%;
    left: 18%;
    background: color-mix(in srgb, var(--accent) 8%, transparent);
  }

  .work-card:hover .art-orbit.one {
    transform: scale(1.05) translate(-2%, -2%);
  }

  .work-card:hover .art-orbit.two {
    transform: translate(7%, -7%);
  }

  .art-type,
  .art-index {
    position: absolute;
    z-index: 1;
    color: color-mix(in srgb, var(--accent) 90%, black);
    font-size: 0.66rem;
    font-weight: 780;
    letter-spacing: 0.13em;
    text-transform: uppercase;
  }

  .art-type {
    top: 1.3rem;
    left: 1.4rem;
  }

  .art-index {
    right: 1.4rem;
    bottom: 1.1rem;
    font-family: var(--font-display);
    font-size: clamp(2.5rem, 8vw, 5.6rem);
    font-style: italic;
    font-weight: 400;
    letter-spacing: -0.06em;
    line-height: 0.8;
    opacity: 0.23;
  }

  .card-body {
    padding: 1.3rem 0 0;
  }

  .meta-row {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    color: var(--muted);
    font-size: 0.7rem;
    font-weight: 680;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .separator {
    color: var(--line-strong);
  }

  .sample-badge {
    margin-left: auto;
    padding: 0.26rem 0.48rem;
    border-radius: 999px;
    color: color-mix(in srgb, var(--coral) 80%, black);
    background: var(--coral-soft);
    font-size: 0.58rem;
  }

  h3 {
    margin: 0.75rem 0 0;
    font-family: var(--font-display);
    font-size: clamp(1.55rem, 2.6vw, 2.15rem);
    font-weight: 560;
    letter-spacing: -0.035em;
    line-height: 1.12;
  }

  h3 a {
    color: var(--ink);
    text-decoration: none;
  }

  h3 a:hover {
    color: var(--accent);
  }

  .summary {
    margin: 0.9rem 0 0;
    color: var(--muted);
    font-size: 0.91rem;
    line-height: 1.68;
  }

  .card-footer {
    min-height: 2.1rem;
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1rem;
    margin-top: 1.2rem;
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .tags li {
    padding: 0.34rem 0.6rem;
    border: 1px solid var(--line);
    border-radius: 999px;
    color: var(--muted);
    font-size: 0.64rem;
    font-weight: 650;
  }

  .read-link {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    color: var(--ink);
    font-size: 0.72rem;
    font-weight: 740;
    white-space: nowrap;
  }

  .large h3 {
    font-size: clamp(1.8rem, 3.5vw, 2.7rem);
  }

  .accent-violet {
    --accent: var(--violet);
    --accent-soft: var(--violet-soft);
  }

  .accent-cyan {
    --accent: var(--cyan);
    --accent-soft: var(--cyan-soft);
  }

  .accent-coral {
    --accent: var(--coral);
    --accent-soft: var(--coral-soft);
  }

  .accent-lime {
    --accent: var(--lime);
    --accent-soft: var(--lime-soft);
  }
</style>
