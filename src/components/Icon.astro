---
interface Props {
  name: 'arrow' | 'email' | 'github' | 'scholar' | 'linkedin' | 'external' | 'download';
  size?: number;
}

const { name, size = 18 } = Astro.props;
---

<svg
  aria-hidden="true"
  class="icon"
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  xmlns="http://www.w3.org/2000/svg"
>
  {
    name === 'arrow' && (
      <>
        <path d="M5 12h13" />
        <path d="m14 7 5 5-5 5" />
      </>
    )
  }
  {
    name === 'external' && (
      <>
        <path d="M14 5h5v5" />
        <path d="m10 14 9-9" />
        <path d="M19 13v5a1 1 0 0 1-1 1H6a1 1 0 0 1-1-1V6a1 1 0 0 1 1-1h5" />
      </>
    )
  }
  {
    name === 'download' && (
      <>
        <path d="M12 3v12" />
        <path d="m7 10 5 5 5-5" />
        <path d="M5 20h14" />
      </>
    )
  }
  {
    name === 'email' && (
      <>
        <rect x="3" y="5" width="18" height="14" rx="2" />
        <path d="m4 7 8 6 8-6" />
      </>
    )
  }
  {
    name === 'github' && (
      <path
        fill="currentColor"
        stroke="none"
        d="M12 2a10 10 0 0 0-3.16 19.49c.5.09.68-.22.68-.48v-1.87c-2.78.6-3.37-1.18-3.37-1.18-.45-1.16-1.11-1.47-1.11-1.47-.91-.62.07-.61.07-.61 1 .07 1.53 1.03 1.53 1.03.9 1.53 2.35 1.09 2.92.83.09-.65.35-1.09.64-1.34-2.22-.25-4.55-1.11-4.55-4.94 0-1.09.39-1.98 1.03-2.68-.1-.25-.45-1.27.1-2.64 0 0 .84-.27 2.75 1.02A9.58 9.58 0 0 1 12 6.82c.85 0 1.71.11 2.51.34 1.91-1.29 2.75-1.02 2.75-1.02.55 1.37.2 2.39.1 2.64.64.7 1.03 1.59 1.03 2.68 0 3.84-2.34 4.68-4.57 4.93.36.31.68.92.68 1.86v2.76c0 .27.18.58.69.48A10 10 0 0 0 12 2Z"
      />
    )
  }
  {
    name === 'scholar' && (
      <>
        <path d="m3 9 9-5 9 5-9 5-9-5Z" />
        <path d="M7 12v4c2.6 2 7.4 2 10 0v-4" />
        <path d="M21 9v6" />
      </>
    )
  }
  {
    name === 'linkedin' && (
      <>
        <rect x="4" y="9" width="3" height="11" rx=".5" />
        <circle cx="5.5" cy="5.5" r="1.5" fill="currentColor" stroke="none" />
        <path d="M11 20V9h3v1.7c.8-1.2 2-2 3.6-2 2.3 0 3.4 1.5 3.4 4.3v7h-3v-6.2c0-1.6-.5-2.5-1.8-2.5-1.4 0-2.2 1-2.2 2.8V20h-3Z" />
      </>
    )
  }
</svg>

<style>
  .icon {
    display: block;
    flex: none;
    stroke: currentColor;
    stroke-width: 1.8;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
</style>
