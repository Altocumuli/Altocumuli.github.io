---
import Icon from '../components/Icon.astro';
import { siteConfig } from '../data/site';
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title={`Page not found — ${siteConfig.name}`} description="The requested page could not be found.">
  <section class="not-found">
    <div class="narrow-container">
      <p>404 · Page not found</p>
      <h1>This path has not been explored yet.</h1>
      <span>
        The page may have moved, or the link may be incomplete. Return home to continue browsing.
      </span>
      <a class="button" href="/">Return home <Icon name="arrow" size={17} /></a>
    </div>
  </section>
</BaseLayout>

<style>
  .not-found {
    min-height: 72vh;
    display: grid;
    place-items: center;
    padding: 5rem 0;
    text-align: center;
  }

  p {
    margin: 0;
    color: var(--violet);
    font-size: 0.68rem;
    font-weight: 760;
    letter-spacing: 0.13em;
    text-transform: uppercase;
  }

  h1 {
    margin: 1rem auto 0;
    font-family: var(--font-display);
    font-size: clamp(3.3rem, 9vw, 7rem);
    font-weight: 440;
    letter-spacing: -0.065em;
    line-height: 0.95;
  }

  span {
    max-width: 520px;
    display: block;
    margin: 1.5rem auto 2rem;
    color: var(--muted);
    line-height: 1.7;
  }
</style>
