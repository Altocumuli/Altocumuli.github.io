---
import { getCollection } from 'astro:content';
import Icon from '../components/Icon.astro';
import SectionHeading from '../components/SectionHeading.astro';
import WorkCard from '../components/WorkCard.astro';
import { siteConfig } from '../data/site';
import BaseLayout from '../layouts/BaseLayout.astro';
import { formatWorkDate, sortWork, workHref } from '../lib/work';

const works = sortWork(await getCollection('work', ({ data }) => !data.draft));
const featuredWorks = works.filter(({ data }) => data.featured).slice(0, 4);
const formatAuthors = (work: (typeof works)[number]) =>
  work.data.authors.length > 12
    ? `${work.data.authors.length} authors · including ${siteConfig.publicationName}`
    : work.data.authors.join(', ');
---

<BaseLayout>
  {
    siteConfig.isDraft && (
      <aside class="setup-notice" aria-label="Setup notice">
        <div class="container setup-inner">
          <span class="setup-dot" aria-hidden="true" />
          <p>
            <strong>Preview mode is on.</strong> Personal information and public research are loaded.
            Add the remaining assets and confirm publishing settings before setting <code>isDraft</code>
            to <code>false</code>.
          </p>
          <a href="https://github.com/Altocumuli" aria-label="Open Altocumuli on GitHub">
            GitHub profile <Icon name="arrow" size={15} />
          </a>
        </div>
      </aside>
    )
  }

  <section class="hero">
    <div class="container hero-grid">
      <div class="hero-copy">
        <p class="hero-eyebrow">
          <span aria-hidden="true" />
          {siteConfig.eyebrow}
        </p>
        <h1>
          Building reliable agents for <em>the real world.</em>
        </h1>
        <p class="hero-intro">{siteConfig.introduction}</p>

        <div class="hero-actions">
          <a class="button" href="#work">Explore my work <Icon name="arrow" size={17} /></a>
          {siteConfig.cv && (
            <a class="button secondary" href={siteConfig.cv}>
              Download CV <Icon name="download" size={16} />
            </a>
          )}
        </div>

        <ul class="hero-facts" aria-label="Profile highlights">
          <li>
            <strong>03</strong>
            <span>Year undergraduate</span>
          </li>
          <li>
            <strong>R + E</strong>
            <span>Research and engineering</span>
          </li>
          <li>
            <strong>BJ</strong>
            <span>Based in Beijing</span>
          </li>
        </ul>
      </div>

      <div class="portrait-wrap" aria-label={`Portrait placeholder for ${siteConfig.name}`}>
        <div class="portrait-backdrop" />
        <div class="portrait-card">
          {
            siteConfig.profileImage ? (
              <img src={siteConfig.profileImage} alt={`Portrait of ${siteConfig.name}`} />
            ) : (
              <div class="portrait-placeholder">
                <span>{siteConfig.initials}</span>
                <small>Agents · Systems</small>
              </div>
            )
          }
        </div>
        <div class="portrait-label label-top">
          <span>Current</span>
          <strong>Tsinghua University</strong>
        </div>
        <div class="portrait-label label-bottom">
          <span class="availability-dot" aria-hidden="true" />
          <strong>{siteConfig.availability}</strong>
        </div>
        <svg class="portrait-orbit" viewBox="0 0 480 480" aria-hidden="true">
          <circle cx="240" cy="240" r="215" />
          <circle cx="240" cy="25" r="5" class="orbit-dot" />
        </svg>
      </div>
    </div>

    <div class="container hero-scroll" aria-hidden="true">
      <span>Scroll to explore</span>
      <i />
    </div>
  </section>

  <section class="section section-rule" id="research">
    <div class="container">
      <SectionHeading
        eyebrow="Research focus"
        title="Agents that learn, search, and act with confidence."
        description="I am interested in the methods and system design needed for agents to preserve context, learn from interaction, and operate reliably over long horizons."
      />

      <div class="interest-grid">
        {
          siteConfig.interests.map((interest) => (
            <article class="interest-card">
              <span class="interest-index">{interest.index}</span>
              <div class="interest-symbol" aria-hidden="true">
                <span />
              </div>
              <h3>{interest.title}</h3>
              <p>{interest.description}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section work-section" id="work">
    <div class="container">
      <SectionHeading
        eyebrow="Selected work"
        title="Research on learning and orchestrating capable agents."
        description="Selected work across agentic reinforcement learning, recursive multi-agent web search, and production-scale agent systems. Reported metrics are attributed to the corresponding paper or system team."
      />

      <div class="work-grid">
        {
          featuredWorks.map((work, index) => (
            <WorkCard work={work} large={index < 2} />
          ))
        }
      </div>
    </div>
  </section>

  <section class="section experience-section" id="experience">
    <div class="container">
      <SectionHeading
        eyebrow="Experience"
        title="Engineering discipline for long-horizon agents."
        description="At Kuaishou, I worked across research and engineering: context management, search data and training, offline evaluation, agent harnesses, state recovery, and safe experiment workflows."
      />

      <div class="experience-list">
        {
          siteConfig.experience.map((experience) => (
            <article class="experience-item">
              <div class="experience-company">
                <div class="company-mark" aria-hidden="true">快</div>
                <div>
                  <h3>{experience.organization}</h3>
                  <p>{experience.location}</p>
                </div>
              </div>

              <div class="experience-details">
                <div class="experience-title">
                  <h4>{experience.role}</h4>
                  <span>{experience.period}</span>
                </div>
                <p class="experience-summary">{experience.summary}</p>
                <ul class="experience-highlights">
                  {experience.highlights.map((highlight) => <li>{highlight}</li>)}
                </ul>
                <ul class="experience-tags" aria-label="Technologies and topics">
                  {experience.tags.map((tag) => <li>{tag}</li>)}
                </ul>
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section section-rule archive-section" aria-labelledby="archive-title">
    <div class="container">
      <div class="archive-heading">
        <div>
          <p class="eyebrow-text">Publications & reports</p>
          <h2 id="archive-title">Complete archive</h2>
        </div>
        <p>All public papers, reports, and projects in reverse chronological order.</p>
      </div>

      <div class="archive-list">
        {
          works.map((work) => (
            <article class="archive-row">
              <time datetime={work.data.date.toISOString()}>{formatWorkDate(work.data.date)}</time>
              <div class="archive-main">
                <div class="archive-meta">
                  <span>{work.data.type}</span>
                  <span>{work.data.status}</span>
                  {work.data.sample && <span class="sample-label">Sample</span>}
                </div>
                <h3><a href={workHref(work)}>{work.data.title}</a></h3>
                <p>{formatAuthors(work)}</p>
              </div>
              <a class="archive-arrow" href={workHref(work)} aria-label={`Read ${work.data.title}`}>
                <Icon name="arrow" size={20} />
              </a>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section about-section" id="about">
    <div class="container about-grid">
      <div class="about-intro">
        <p class="eyebrow-text">About</p>
        <h2>Research-minded.<br /><em>Systems-ready.</em></h2>
      </div>

      <div class="about-copy">
        <p class="lead">
          I am {siteConfig.name}, a third-year Software Engineering undergraduate at {siteConfig.institution}.
          I work on LLM agents, agentic reinforcement learning, and the harnesses that help
          long-running agents remain reliable outside a notebook.
        </p>
        <p>
          I am drawn to agents because they give language models the ability to interact with and
          affect the real world. My recent work at Kuaishou connects algorithmic research with
          system questions such as context growth, evidence consistency, state recovery, safety
          checks, and feedback-driven iteration. I value independent thinking, adapt quickly to new
          environments, and am comfortable working through uncertain, high-pressure problems.
        </p>

        <div class="education-card">
          <div class="education-mark" aria-hidden="true">THU</div>
          <div>
            <span>Education</span>
            <h3>{siteConfig.education.school}</h3>
            <p>{siteConfig.education.degree} · {siteConfig.education.period}</p>
            <small>{siteConfig.education.details}</small>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="contact-section" id="contact">
    <div class="container contact-card">
      <div class="contact-orbit" aria-hidden="true" />
      <p class="eyebrow-text">Start a conversation</p>
      <h2>Have a question worth exploring?</h2>
      <p>
        I am always glad to discuss research ideas, potential collaborations, and opportunities to
        learn from ambitious teams.
      </p>
      <div class="contact-actions">
        <a class="button contact-button" href={`mailto:${siteConfig.email}`}>
          Email me <Icon name="email" size={17} />
        </a>
        {
          siteConfig.socials
            .filter((social) => social.icon !== 'email')
            .map((social) => (
              <a class="contact-social" href={social.href} aria-label={social.label}>
                <Icon name={social.icon} size={19} />
              </a>
            ))
        }
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .setup-notice {
    border-bottom: 1px solid color-mix(in srgb, var(--coral) 22%, var(--line));
    color: #713b2e;
    background: color-mix(in srgb, var(--coral-soft) 70%, var(--paper));
  }

  .setup-inner {
    min-height: 3.2rem;
    display: flex;
    align-items: center;
    gap: 0.7rem;
  }

  .setup-inner p {
    flex: 1;
    margin: 0;
    font-size: 0.74rem;
    line-height: 1.5;
  }

  .setup-inner code {
    padding: 0.1rem 0.25rem;
    border-radius: 4px;
    background: rgba(255, 255, 255, 0.55);
    font-size: 0.68rem;
  }

  .setup-inner a {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-size: 0.7rem;
    font-weight: 740;
    white-space: nowrap;
  }

  .setup-dot {
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    background: var(--coral);
    box-shadow: 0 0 0 4px color-mix(in srgb, var(--coral) 14%, transparent);
  }

  .hero {
    position: relative;
    min-height: calc(100svh - 74px);
    padding: clamp(4.5rem, 9vw, 8rem) 0 2rem;
    overflow: hidden;
  }

  .hero::before {
    position: absolute;
    width: min(40vw, 35rem);
    height: min(40vw, 35rem);
    top: 5%;
    right: -13%;
    border: 1px solid color-mix(in srgb, var(--violet) 12%, transparent);
    border-radius: 50%;
    content: '';
  }

  .hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.18fr) minmax(320px, 0.82fr);
    align-items: center;
    gap: clamp(3rem, 7vw, 7rem);
  }

  .hero-copy {
    position: relative;
    z-index: 2;
  }

  .hero-eyebrow {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    margin: 0 0 1.3rem;
    color: var(--muted);
    font-size: 0.72rem;
    font-weight: 690;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .hero-eyebrow span {
    width: 1.8rem;
    height: 1px;
    background: var(--violet);
  }

  h1 {
    max-width: 800px;
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(3.8rem, 7.6vw, 7.5rem);
    font-weight: 430;
    letter-spacing: -0.072em;
    line-height: 0.88;
  }

  h1 em {
    color: var(--violet);
    font-weight: 400;
  }

  .hero-intro {
    max-width: 650px;
    margin: 2rem 0 0;
    color: var(--muted);
    font-size: clamp(1rem, 1.7vw, 1.15rem);
    line-height: 1.78;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 2rem;
  }

  .hero-facts {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1rem;
    max-width: 650px;
    margin: clamp(3rem, 6vw, 5rem) 0 0;
    padding: 1.25rem 0 0;
    border-top: 1px solid var(--line);
    list-style: none;
  }

  .hero-facts li {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .hero-facts strong {
    font-family: var(--font-display);
    font-size: 1.35rem;
    font-style: italic;
    font-weight: 500;
  }

  .hero-facts span {
    color: var(--muted);
    font-size: 0.68rem;
    line-height: 1.4;
  }

  .portrait-wrap {
    position: relative;
    z-index: 1;
    width: min(100%, 430px);
    aspect-ratio: 0.88;
    justify-self: end;
  }

  .portrait-backdrop {
    position: absolute;
    inset: 8% -6% -2% 10%;
    transform: rotate(4deg);
    border-radius: 47% 47% 28px 28px;
    background: var(--violet-soft);
  }

  .portrait-card {
    position: absolute;
    inset: 0 4% 3% 0;
    overflow: hidden;
    border: 1px solid color-mix(in srgb, var(--violet) 18%, var(--line));
    border-radius: 48% 48% var(--radius-lg) var(--radius-lg);
    background:
      radial-gradient(circle at 50% 28%, rgba(255, 255, 255, 0.9), transparent 27%),
      linear-gradient(155deg, #e8e4ef, #cbc4db);
    box-shadow: var(--shadow-soft);
  }

  .portrait-card img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .portrait-placeholder {
    width: 100%;
    height: 100%;
    display: grid;
    place-items: center;
    align-content: center;
    gap: 1rem;
    color: var(--violet);
    background:
      linear-gradient(120deg, transparent 48%, rgba(255, 255, 255, 0.25) 49%, transparent 50%),
      repeating-linear-gradient(0deg, transparent 0 38px, rgba(108, 69, 216, 0.055) 39px 40px);
  }

  .portrait-placeholder span {
    font-family: var(--font-display);
    font-size: clamp(5rem, 12vw, 9rem);
    font-style: italic;
    letter-spacing: -0.08em;
  }

  .portrait-placeholder small {
    font-size: 0.66rem;
    font-weight: 750;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .portrait-orbit {
    position: absolute;
    z-index: -1;
    width: 118%;
    max-width: none;
    top: -10%;
    left: -12%;
    overflow: visible;
    animation: rotate-orbit 28s linear infinite;
  }

  .portrait-orbit circle {
    fill: none;
    stroke: color-mix(in srgb, var(--violet) 25%, transparent);
    stroke-width: 1;
    stroke-dasharray: 3 8;
  }

  .portrait-orbit .orbit-dot {
    fill: var(--violet);
    stroke: none;
  }

  @keyframes rotate-orbit {
    to { transform: rotate(360deg); }
  }

  .portrait-label {
    position: absolute;
    z-index: 3;
    display: flex;
    padding: 0.8rem 1rem;
    border: 1px solid rgba(255, 255, 255, 0.72);
    border-radius: var(--radius-sm);
    background: rgba(251, 250, 246, 0.83);
    box-shadow: 0 12px 30px rgba(35, 27, 52, 0.09);
    backdrop-filter: blur(14px);
  }

  .label-top {
    top: 15%;
    left: -17%;
    flex-direction: column;
    gap: 0.3rem;
  }

  .label-top span {
    color: var(--muted);
    font-size: 0.58rem;
    font-weight: 750;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .label-top strong {
    font-family: var(--font-display);
    font-size: 0.92rem;
  }

  .label-bottom {
    right: -9%;
    bottom: 11%;
    align-items: center;
    gap: 0.65rem;
    max-width: 12rem;
  }

  .label-bottom strong {
    font-size: 0.68rem;
    line-height: 1.45;
  }

  .availability-dot {
    width: 0.55rem;
    height: 0.55rem;
    flex: none;
    border-radius: 50%;
    background: #4f9d5e;
    box-shadow: 0 0 0 4px rgba(79, 157, 94, 0.14);
  }

  .hero-scroll {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    margin-top: clamp(3rem, 7vw, 6rem);
    color: var(--muted-light);
    font-size: 0.62rem;
    font-weight: 680;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .hero-scroll i {
    width: 3rem;
    height: 1px;
    background: var(--line-strong);
  }

  .interest-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1px;
    overflow: hidden;
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    background: var(--line);
  }

  .interest-card {
    position: relative;
    min-height: 320px;
    padding: clamp(1.5rem, 3vw, 2.2rem);
    background: var(--paper-raised);
  }

  .interest-index {
    color: var(--muted);
    font-family: var(--font-display);
    font-size: 0.78rem;
    font-style: italic;
  }

  .interest-symbol {
    width: 5.5rem;
    height: 5.5rem;
    display: grid;
    place-items: center;
    margin: 2.8rem 0 2.3rem;
    border: 1px solid color-mix(in srgb, var(--violet) 35%, var(--line));
    border-radius: 50%;
    transition: transform 400ms var(--ease-out);
  }

  .interest-symbol::before,
  .interest-symbol::after,
  .interest-symbol span {
    position: absolute;
    width: 2.3rem;
    height: 2.3rem;
    border: 1px solid var(--violet);
    border-radius: 50%;
    content: '';
  }

  .interest-symbol::before { transform: translateX(-0.75rem); }
  .interest-symbol::after { transform: translateX(0.75rem); }
  .interest-symbol span { transform: translateY(0.75rem); opacity: 0.5; }

  .interest-card:nth-child(2) .interest-symbol {
    border-radius: 22%;
    transform: rotate(45deg);
  }

  .interest-card:nth-child(2) .interest-symbol::before,
  .interest-card:nth-child(2) .interest-symbol::after,
  .interest-card:nth-child(2) .interest-symbol span {
    border-radius: 4px;
  }

  .interest-card:nth-child(3) .interest-symbol {
    border-style: dashed;
  }

  .interest-card:hover .interest-symbol { transform: rotate(8deg) scale(1.04); }
  .interest-card:nth-child(2):hover .interest-symbol { transform: rotate(53deg) scale(1.04); }

  .interest-card h3 {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(1.35rem, 2.4vw, 1.8rem);
    font-weight: 560;
    letter-spacing: -0.03em;
  }

  .interest-card p {
    margin: 0.9rem 0 0;
    color: var(--muted);
    font-size: 0.86rem;
    line-height: 1.7;
  }

  .work-section {
    color: #f7f5ee;
    background: #1b191f;
  }

  .work-section :global(.section-heading .description),
  .work-section :global(.work-card .summary),
  .work-section :global(.work-card .meta-row) {
    color: #aaa6af;
  }

  .work-section :global(.section-heading .eyebrow),
  .about-section .eyebrow-text {
    color: #b8a4ee;
  }

  .work-section :global(.work-card h3 a),
  .work-section :global(.work-card .read-link) {
    color: #f7f5ee;
  }

  .work-section :global(.work-card .tags li) {
    border-color: #3a3740;
    color: #aaa6af;
  }

  .work-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(3rem, 7vw, 6rem) clamp(1.5rem, 4vw, 3.5rem);
  }

  .experience-section {
    background: var(--paper-raised);
  }

  .experience-list {
    border-top: 1px solid var(--line);
  }

  .experience-item {
    display: grid;
    grid-template-columns: minmax(240px, 0.7fr) minmax(0, 1.3fr);
    gap: clamp(2rem, 7vw, 7rem);
    padding: clamp(2.5rem, 5vw, 4rem) 0;
    border-bottom: 1px solid var(--line);
  }

  .experience-company {
    display: flex;
    align-items: flex-start;
    gap: 1.1rem;
  }

  .company-mark {
    width: 3.2rem;
    height: 3.2rem;
    display: grid;
    place-items: center;
    flex: none;
    border-radius: 15px;
    color: white;
    background: linear-gradient(145deg, #ff734f, #e84435);
    box-shadow: 0 9px 24px rgba(211, 72, 54, 0.18);
    font-family: var(--font-display);
    font-size: 1.1rem;
    font-weight: 650;
  }

  .experience-company h3,
  .experience-title h4 {
    margin: 0;
    font-family: var(--font-display);
    font-size: 1.35rem;
    font-weight: 600;
    letter-spacing: -0.025em;
  }

  .experience-company p {
    margin: 0.35rem 0 0;
    color: var(--muted);
    font-size: 0.75rem;
  }

  .experience-title {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
  }

  .experience-title span {
    color: var(--muted);
    font-size: 0.72rem;
    font-weight: 680;
  }

  .experience-summary {
    margin: 1.2rem 0 0;
    color: var(--muted);
    line-height: 1.75;
  }

  .experience-highlights {
    display: grid;
    gap: 0.7rem;
    margin: 1.3rem 0 0;
    padding: 0;
    list-style: none;
  }

  .experience-highlights li {
    position: relative;
    padding-left: 1.1rem;
    color: var(--muted);
    font-size: 0.88rem;
    line-height: 1.65;
  }

  .experience-highlights li::before {
    position: absolute;
    top: 0.7em;
    left: 0;
    width: 0.3rem;
    height: 0.3rem;
    border-radius: 50%;
    background: var(--coral);
    content: '';
  }

  .experience-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
    margin: 1.5rem 0 0;
    padding: 0;
    list-style: none;
  }

  .experience-tags li {
    padding: 0.38rem 0.65rem;
    border: 1px solid var(--line);
    border-radius: 999px;
    color: var(--muted);
    background: var(--paper);
    font-size: 0.66rem;
    font-weight: 650;
  }

  .archive-heading {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 2rem;
    margin-bottom: 3rem;
  }

  .archive-heading h2 {
    margin: 0.65rem 0 0;
    font-family: var(--font-display);
    font-size: clamp(2.4rem, 5vw, 4.5rem);
    font-weight: 480;
    letter-spacing: -0.055em;
